{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lubanda.local/schemas/error-codes.schema.json",
  "title": "Lubanda Engine Issue",
  "type": "object",
  "required": [
    "code",
    "severity",
    "messageKey",
    "stage",
    "recoverable"
  ],
  "properties": {
    "code": {
      "enum": [
        "EMPTY_FILE",
        "MISSING_COLUMN",
        "EMPTY_ID",
        "EMPTY_NAME",
        "DUPLICATE_ID",
        "SELF_PARENT",
        "MISSING_PARENT",
        "NO_ROOT",
        "MULTIPLE_ROOTS",
        "CYCLE",
        "GENERATION_MISMATCH",
        "UNREACHABLE_PERSON",
        "MALFORMED_VALUE",
        "DEMAND_CONFIG_INVALID",
        "TEMPLATE_INVALID",
        "TERRITORY_MISSING",
        "TERRITORY_INVALID_GEOMETRY",
        "TERRITORY_OUT_OF_BOUNDS",
        "TERRITORY_AREA_INSUFFICIENT",
        "TERRITORY_OVERLAP",
        "TERRITORY_OWNERSHIP_CONFLICT",
        "TERRITORY_RELATION_INVALID",
        "CORRIDOR_INVALID",
        "CORRIDOR_TOO_NARROW",
        "CORRIDOR_OUT_OF_BOUNDS",
        "JUNCTION_RESERVATION_VIOLATION",
        "TERRITORY_NEGOTIATION_FAILED",
        "TERRITORY_NON_DETERMINISTIC",
        "NON_SERIALIZABLE_RESULT",
        "SKELETON_TRUNK_INVALID",
        "SKELETON_JUNCTION_INVALID",
        "SKELETON_BRANCH_INVALID",
        "SKELETON_BRANCH_OUT_OF_BOUNDS",
        "SKELETON_BRANCH_EXCESSIVE_CURVATURE",
        "SKELETON_BRANCH_TOO_SHORT",
        "SKELETON_BRANCH_INTERSECTION",
        "SKELETON_NO_VALID_CANDIDATE",
        "SKELETON_MISSING_PERSON",
        "SKELETON_ORPHAN_BRANCH",
        "SKELETON_TERRITORY_MISS",
        "SKELETON_TREE_INCOMPLETE",
        "COLLISION_BRANCH_BRANCH",
        "COLLISION_BRANCH_BOUNDARY",
        "COLLISION_SELF_INTERSECTION",
        "COLLISION_CLEARANCE_DEFICIT",
        "COLLISION_PENETRATION",
        "COLLISION_RESOLUTION_FAILED",
        "COLLISION_NON_DETERMINISTIC",
        "LABEL_MEASUREMENT_FAILED",
        "LABEL_FONT_MISSING",
        "LABEL_FONT_LOAD_FAILED",
        "LABEL_NO_CANDIDATES",
        "LABEL_ALL_CANDIDATES_COLLIDE",
        "LABEL_BACKTRACK_EXHAUSTED",
        "LABEL_PLACEMENT_IMPOSSIBLE",
        "LABEL_OVERLAP_DETECTED",
        "LABEL_TEXT_TOO_LONG",
        "LABEL_INVALID_PERSON_REFERENCE",
        "LABEL_NON_DETERMINISTIC"
      ]
    },
    "severity": {
      "enum": [
        "FATAL",
        "ERROR",
        "WARNING",
        "INFO"
      ]
    },
    "messageKey": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "ACQUIRE",
        "NORMALIZE",
        "VALIDATE",
        "BUILD_GRAPH",
        "CONFIGURATION",
        "COMPUTE_DEMAND",
        "ALLOCATE_TERRITORIES",
        "PLAN_CORRIDORS",
        "NEGOTIATE_TERRITORIES",
        "VALIDATE_TERRITORIES",
        "SERIALIZE_TERRITORIES",
        "PLAN_TRUNK",
        "PLAN_JUNCTIONS",
        "GROW_SKELETON",
        "GENERATE_CANDIDATES",
        "REJECT_CANDIDATES",
        "SCORE_CANDIDATES",
        "VALIDATE_SKELETON",
        "FREEZE_SKELETON",
        "BUILD_COLLISION_INDEX",
        "TEST_BRANCH_COLLISIONS",
        "TEST_SELF_COLLISION",
        "TEST_BOUNDARY_CONTAINMENT",
        "RESOLVE_LOCAL_COLLISIONS",
        "VALIDATE_COLLISION_SAFETY",
        "MEASURE_TEXT",
        "SOLVE_LABELS",
        "VALIDATE_LABELS"
      ]
    },
    "entityIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "field": {
      "type": "string"
    },
    "rowNumber": {
      "type": "integer",
      "minimum": 1
    },
    "details": {
      "type": "object"
    },
    "recoverable": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
